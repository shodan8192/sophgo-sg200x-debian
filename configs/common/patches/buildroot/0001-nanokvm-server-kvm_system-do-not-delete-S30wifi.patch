 1 file changed, 24 insertions(+)
 create mode 100644 package/nanokvm-server/0024-support-kvm_system-do-not-delete-S30wifi.patch

diff --git a/package/nanokvm-server/0024-support-kvm_system-do-not-delete-S30wifi.patch b/package/nanokvm-server/0024-support-kvm_system-do-not-delete-S30wifi.patch
